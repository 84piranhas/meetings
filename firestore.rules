rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Un espace par entreprise : tenants/<nom-normalisé>/<collection>/<document>
    // Protection faible, voulue : quiconque connaît le nom de l'entreprise lit et écrit.
    // On ne peut pas lister les entreprises (aucune règle sur /tenants lui-même).
    match /tenants/{tenant}/{coll}/{docId} {
      allow read, write: if tenant.size() <= 80
        && coll in ['poles', 'products', 'cards', 'requests', 'deck', 'members'];
    }
    // Tout le reste est refusé par défaut.
  }
}
